{
  "manifest_version": 3,
  "name": "TypoFixer - Smart Bilingual Typo & Layout Fixer",
  "version": "1.0.0",
  "description": "Fix typos, accidental Arabic/English layout swaps, grammar and punctuation instantly with Alt+Q anywhere on the web.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TypoFixer Settings & Playground",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core/engine.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "fix-typo-command": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Fix typos and keyboard layout in current text field"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
